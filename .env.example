# Copy this file to .env (git-ignored) and fill in the real values.
# Used by compose.yaml. PEM keys must be on a single line, with literal \n
# in place of each newline (the services convert them back at startup).

JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<BASE64_PRIVATE_KEY_CONTENT>\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<BASE64_PUBLIC_KEY_CONTENT>\n-----END PUBLIC KEY-----

# Password for the admin@orderflow.com user seeded at startup (Development only).
# Must satisfy the Identity policy: min 8 chars, at least one digit and one non-alphanumeric char.
ADMIN_SEED_PASSWORD=<ADMIN_SEED_PASSWORD>
